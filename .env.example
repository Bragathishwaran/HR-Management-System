# Copy to .env and set a strong SECRET_KEY in production (min 32 chars).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
DATABASE_URL=sqlite+aiosqlite:///./hrms.db
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:4173"]
ENVIRONMENT=development

# Attendance rules (Module 10)
WORK_START_HOUR=9
WORK_START_MINUTE=0
LATE_GRACE_MINUTES=15
STANDARD_WORK_HOURS=8
HALF_DAY_THRESHOLD_HOURS=4

# Default yearly leave allocations (Module 11)
DEFAULT_SICK_LEAVE_DAYS=12
DEFAULT_CASUAL_LEAVE_DAYS=12
DEFAULT_PAID_LEAVE_DAYS=20

# Shift automation (Module 14) — off by default
AUTO_ATTENDANCE_ENABLED=false
AUTO_ATTENDANCE_INTERVAL_MINUTES=60

# Leave calendar conflict guard (Module 15) — 0 disables the cap
MAX_CONCURRENT_DEPARTMENT_LEAVE=0

# Secure document vault (Module 16)
DOCUMENT_STORAGE_PATH=storage/documents
MAX_DOCUMENT_SIZE_MB=10
ALLOWED_DOCUMENT_EXTENSIONS=pdf,png,jpg,jpeg,doc,docx

# Smart document-expiry alerts (Module 19)
DOCUMENT_EXPIRY_WARNING_DAYS=30
